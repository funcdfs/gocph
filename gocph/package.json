{
    "name": "gocph",
    "displayName": "GoCPH - Go Test Runner",
    "description": "Go 程序测试运行器，支持输入输出对比测试",
    "license": "GPL-3.0-or-later",
    "publisher": "LocalDev",
    "version": "1.0.0",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Testing"
    ],
    "activationEvents": [
        "onLanguage:go"
    ],
    "main": "dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "gocph-judge-view-container",
                    "title": "GoCPH",
                    "icon": "data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNMTMgNWgtMnY2SDV2Mmg2djZoMnYtNmg2di0yaC02VjV6IiBmaWxsPSIjRkZDQzAwIi8+PC9zdmc+"
                }
            ]
        },
        "languages": [
            {
                "id": "go",
                "configuration": "./language-configuration.json"
            }
        ],
        "snippets": [
            {
                "language": "go",
                "path": "./snippets/go.json"
            }
        ],
        "views": {
            "gocph-judge-view-container": [
                {
                    "type": "webview",
                    "id": "gocph.judgeView",
                    "name": ""
                }
            ]
        },
        "commands": [
            {
                "command": "gocph.runAllTests",
                "title": "GoCPH: 运行所有测试",
                "icon": "$(play)"
            },
            {
                "command": "gocph.stopTests",
                "title": "GoCPH: 停止运行测试",
                "icon": "$(debug-stop)"
            },
            {
                "command": "gocph.foldAllRegions",
                "title": "GoCPH: 切换折叠所有 Region",
                "icon": "$(folding-expanded)"
            },
            {
                "command": "gocph.copyCode",
                "title": "GoCPH: 复制代码",
                "icon": "$(copy)"
            }
        ],
        "keybindings": [
            {
                "key": "alt+1",
                "mac": "alt+1",
                "command": "gocph.runAllTests",
                "when": "editorTextFocus"
            },
            {
                "key": "alt+2",
                "mac": "alt+2",
                "command": "gocph.stopTests",
                "when": "editorTextFocus"
            },
            {
                "key": "alt+3",
                "mac": "alt+3",
                "command": "gocph.foldAllRegions",
                "when": "editorTextFocus"
            },
            {
                "key": "alt+4",
                "mac": "alt+4",
                "command": "gocph.copyCode",
                "when": "editorTextFocus"
            }
        ],
        "configuration": {
            "title": "GoCPH",
            "properties": {
                "gocph.超时时间": {
                    "type": "number",
                    "default": 10000,
                    "description": "测试用例运行超时时间（毫秒）"
                },
                "gocph.编译成功时隐藏警告": {
                    "type": "boolean",
                    "default": true,
                    "description": "编译成功时忽略并隐藏标准错误输出"
                },
                "gocph.忽略标准错误": {
                    "type": "boolean",
                    "default": false,
                    "description": "启用后，非空标准错误不会导致测试失败"
                },
                "gocph.编译参数": {
                    "type": "string",
                    "default": "",
                    "description": "编译 Go 文件时传递的额外参数，用空格分隔"
                },
                "gocph.Go命令": {
                    "type": "string",
                    "default": "go",
                    "description": "用于编译 .go 文件的命令"
                },
                "gocph.自动显示结果面板": {
                    "type": "boolean",
                    "default": true,
                    "description": "打开关联测试的文件时自动显示结果面板"
                },
                "gocph.Companion端口": {
                    "type": "number",
                    "default": 27121,
                    "description": "Competitive Companion 监听端口（默认 27121，与 CPH 兼容）"
                }
            }
        }
    },
    "scripts": {
        "build": "npm run build:frontend && npm run build:extension && npm run copy:assets",
        "build:frontend": "vite build",
        "build:extension": "vite build --config vite.extension.config.ts",
        "copy:assets": "cp src/webview/frontend/index.html dist/ && cp src/webview/frontend/app.css dist/ && cp node_modules/@vscode/codicons/dist/codicon.css dist/ && cp node_modules/@vscode/codicons/dist/codicon.ttf dist/",
        "dev": "npm run build",
        "watch": "npm run build:frontend && vite build --config vite.extension.config.ts --watch",
        "vscode:prepublish": "npm run build",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "clean": "rm -rf dist out"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/node": "^22.10.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@types/vscode": "^1.85.0",
        "@vitejs/plugin-react": "^4.3.0",
        "@vscode/codicons": "^0.0.36",
        "eslint": "^9.17.0",
        "eslint-plugin-react": "^7.37.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "fast-check": "^4.5.3",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.18.0",
        "vite": "^6.0.0",
        "vitest": "^2.1.0"
    },
    "dependencies": {
        "@types/canvas-confetti": "^1.9.0",
        "canvas-confetti": "^1.9.4",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "react-textarea-autosize": "^8.5.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/example/go-test-runner/"
    }
}
