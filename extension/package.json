{
    "name": "gocph",
    "displayName": "GoCPH - Go Test Runner",
    "description": "Go 程序测试运行器，支持输入输出对比测试",
    "license": "GPL-3.0-or-later",
    "publisher": "funcdfs",
    "version": "3.0.0",
    "icon": "icon.png",
    "galleryBanner": {
        "color": "#00ADD8",
        "theme": "dark"
    },
    "keywords": [
        "go",
        "golang",
        "competitive programming",
        "codeforces",
        "atcoder",
        "leetcode",
        "cph"
    ],
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Testing",
        "Snippets",
        "Other"
    ],
    "main": "dist/extension.js",
    "activationEvents": [
        "onLanguage:go"
    ],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "gocph-judge-view-container",
                    "title": "GoCPH",
                    "icon": "icon-sidebar.svg"
                }
            ]
        },
        "languages": [
            {
                "id": "go",
                "configuration": "./language-configuration.json"
            }
        ],
        "snippets": [
            {
                "language": "go",
                "path": "./snippets/go.json"
            }
        ],
        "views": {
            "gocph-judge-view-container": [
                {
                    "type": "webview",
                    "id": "gocph.judgeView",
                    "name": "",
                    "icon": "icon-sidebar.svg"
                }
            ]
        },
        "commands": [
            {
                "command": "gocph.runAllTests",
                "title": "GoCPH: 运行所有测试",
                "icon": "$(play)"
            },
            {
                "command": "gocph.stopTests",
                "title": "GoCPH: 停止运行测试",
                "icon": "$(debug-stop)"
            },
            {
                "command": "gocph.copyCode",
                "title": "GoCPH: 复制代码",
                "icon": "$(copy)"
            }
        ],
        "keybindings": [
            {
                "key": "alt+1",
                "mac": "alt+1",
                "command": "gocph.runAllTests",
                "when": "editorTextFocus"
            },
            {
                "key": "alt+2",
                "mac": "alt+2",
                "command": "gocph.stopTests",
                "when": "editorTextFocus"
            },
            {
                "key": "alt+3",
                "mac": "alt+3",
                "command": "gocph.copyCode",
                "when": "editorTextFocus"
            }
        ],
        "configuration": {
            "title": "GoCPH",
            "properties": {
                "gocph.超时时间": {
                    "type": "number",
                    "default": 10000,
                    "description": "测试用例运行超时时间（毫秒）"
                },
                "gocph.编译成功时隐藏警告": {
                    "type": "boolean",
                    "default": true,
                    "description": "编译成功时忽略并隐藏标准错误输出"
                },
                "gocph.忽略标准错误": {
                    "type": "boolean",
                    "default": false,
                    "description": "启用后，非空标准错误不会导致测试失败"
                },
                "gocph.编译参数": {
                    "type": "string",
                    "default": "",
                    "description": "编译 Go 文件时传递的额外参数，用空格分隔"
                },
                "gocph.Go命令": {
                    "type": "string",
                    "default": "go",
                    "description": "用于编译 .go 文件的命令"
                },
                "gocph.自动显示结果面板": {
                    "type": "boolean",
                    "default": true,
                    "description": "打开关联测试的文件时自动显示结果面板"
                },
                "gocph.Companion端口": {
                    "type": "number",
                    "default": 27121,
                    "description": "Competitive Companion 监听端口（默认 27121，与 CPH 兼容）"
                },
                "gocph.自动折叠骨架": {
                    "type": "boolean",
                    "default": true,
                    "description": "插入 cp / tt / ttna 模板后，自动折叠 // #region main 骨架代码"
                }
            }
        }
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "watch": "node scripts/build.mjs --watch",
        "vscode:prepublish": "npm run build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vitest run",
        "check": "npm run typecheck && npm run lint && npm run test",
        "package": "./package.sh",
        "clean": "rm -rf dist",
        "test:vscode": "node test/vscode/run.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/canvas-confetti": "^1.9.0",
        "@types/node": "^22.10.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@types/vscode": "^1.85.0",
        "@vscode/codicons": "^0.0.36",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.3.0",
        "esbuild": "^0.25.0",
        "eslint": "^9.17.0",
        "eslint-plugin-react": "^7.37.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.18.0",
        "vitest": "^2.1.0"
    },
    "dependencies": {
        "canvas-confetti": "^1.9.4",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "react-textarea-autosize": "^8.5.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/funcdfs/gocph.git"
    },
    "homepage": "https://github.com/funcdfs/gocph#readme",
    "bugs": {
        "url": "https://github.com/funcdfs/gocph/issues"
    }
}
